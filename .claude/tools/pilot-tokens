#!/bin/zsh
# pilot-tokens --from <iso> [--sc <id9>...] [--exclude <id9>...] : token use per level of the pilot (read-only).
# Levels: release-coord = main transcript; step-coord = subagent files whose first 9 chars after "agent-" are in --sc;
# then verifier / implementer / reviewer / other by the tool's role. input-equivalent = input + 1.25*cache_write +
# 0.1*cache_read + 5*output. Then a per-transcript list. Exit 0; 2 usage.
set -u
from=; sc=(); ex=(); mode=
while (( $# )); do case $1 in --from) from=${2:-}; shift; mode=;; --sc) mode=sc;; --exclude) mode=ex;;
  *) case $mode in sc) sc+=($1);; ex) ex+=($1);; *) echo "usage: pilot-tokens --from <iso> [--sc <id9>...] [--exclude <id9>...]"; exit 2;; esac;; esac; shift; done
[[ -n $from ]] || { echo "usage: pilot-tokens --from <iso> [--sc <id9>...] [--exclude <id9>...]"; exit 2; }
P=~/.claude/projects/-Users-iposukhoff-L2Solo/${RC_SESSION:?set RC_SESSION=<session uuid> (the RC transcript to measure)}
T=${0:A:h}/token-usage.py
SC="${(j: :)sc}" EX="${(j: :)ex}" python3 -I -B - $T $from $P/subagents $P.jsonl <<'PY'
import sys,os,json,importlib.util,collections
tool,lo,sub,main=sys.argv[1:5]
spec=importlib.util.spec_from_file_location('tu',tool); tu=importlib.util.module_from_spec(spec); spec.loader.exec_module(tu)
sc=set(os.environ['SC'].split()); ex=set(os.environ['EX'].split())
rows,_=tu.count([sub,main],lo)
def id9(f): return f[6:15] if f.startswith('agent-') else f[:9]
lv=collections.defaultdict(collections.Counter); cnt=collections.Counter(); per=[]
for r in rows:
    i=id9(r['file'])
    if i in ex: continue
    ismain=not r['file'].startswith('agent-')
    k='release-coord' if ismain else ('step-coord' if i in sc else r['role'])
    ie=r['input']+1.25*r['cache_write']+0.1*r['cache_read']+5*r['output']
    lv[k]['messages']+=r['messages']; lv[k]['output']+=r['output']; lv[k]['ie']+=ie; cnt[k]+=1
    per.append((i,k,r['model'] or '-',r['first'][:19],r['last'][:19],ie/1e6))
tot=sum(v['ie'] for v in lv.values()) or 1
print('%-14s %11s %9s %10s %14s %6s'%('level','transcripts','messages','output','input-equiv','share'))
order=['release-coord','step-coord','verifier','implementer','reviewer','other']+sorted(k for k in lv if k not in ('release-coord','step-coord','verifier','implementer','reviewer','other'))
for k in order:
    if k in lv: v=lv[k]; print('%-14s %11d %9d %10d %14d %5.1f%%'%(k,cnt[k],v['messages'],v['output'],v['ie'],100*v['ie']/tot))
print('%-14s %11d %9d %10d %14d'%('ALL',sum(cnt.values()),sum(v['messages'] for v in lv.values()),sum(v['output'] for v in lv.values()),tot))
print('\nid9        role           model                first (UTC)          last (UTC)           M')
for p in sorted(per,key=lambda x:x[3]): print('%-10s %-14s %-20s %s  %s  %.2f'%(p[0],p[1],p[2][:20],p[3],p[4],p[5]))
PY
